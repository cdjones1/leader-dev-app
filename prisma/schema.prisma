// ============================================================
// This file describes every table in the database.
// Run `npx prisma migrate dev` to turn this into a real database.
// ============================================================

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ------------------------------------------------------------
// ROLES — the 5-tier hierarchy plus an admin flag
// ------------------------------------------------------------
enum Role {
  OPERATIONS_SPECIALIST
  TEAM_LEADER
  MANAGER
  ASSISTANT_DIRECTOR
  DIRECTOR
}

// ------------------------------------------------------------
// USERS
// ------------------------------------------------------------
model User {
  id           String   @id @default(uuid())
  name         String
  email        String   @unique
  passwordHash String   // never store plain passwords — this is the encrypted version
  role         Role
  isAdmin      Boolean  @default(false)
  createdAt    DateTime @default(now())

  // A user can be a manager to other users (self-referencing relationship)
  managerId    String?
  manager      User?    @relation("ManagerToReports", fields: [managerId], references: [id])
  reports      User[]   @relation("ManagerToReports")

  // Pairings this user is part of (as either developer or developee)
  pairingsAsDeveloper DeveloperPairing[] @relation("DeveloperPairings")
  pairingsAsDevelopee DeveloperPairing[] @relation("DevelopeePairings")
}

// ------------------------------------------------------------
// DEVELOPER PAIRINGS — admin-assigned developer <-> developee link
// ------------------------------------------------------------
enum PairingStatus {
  ACTIVE
  ENDED
}

model DeveloperPairing {
  id          String        @id @default(uuid())
  developerId String
  developer   User          @relation("DeveloperPairings", fields: [developerId], references: [id])
  developeeId String
  developee   User          @relation("DevelopeePairings", fields: [developeeId], references: [id])
  status      PairingStatus @default(ACTIVE)
  assignedBy  String        // the admin's user id who created this pairing
  startDate   DateTime      @default(now())
  endDate     DateTime?

  plans       DevelopmentPlan[]
}

// ------------------------------------------------------------
// DEVELOPMENT PLANS — the 30-day / 8-module process
// ------------------------------------------------------------
enum PlanStatus {
  IN_PROGRESS
  COMPLETE
}

model DevelopmentPlan {
  id        String     @id @default(uuid())
  pairingId String
  pairing   DeveloperPairing @relation(fields: [pairingId], references: [id])
  pathId    String?    // which path this plan was built from - informational only, the plan's own modules/sections/tasks are already fully copied
  pathName  String?    // the path's name at creation time, so history reads correctly even if the path is later renamed or deleted
  moduleCount Int      @default(8) // how many modules THIS plan has - snapshotted at creation, so a path's module count changing later never affects plans already running
  goalDays  Int      @default(30) // this plan's own goal/max days, snapshotted at creation
  maxDays   Int      @default(40)
  status    PlanStatus @default(IN_PROGRESS)
  createdAt DateTime   @default(now())
  startedAt DateTime?  // set the moment module 1 is actually opened - this is when the real 40-day clock begins, not when the plan record was created

  modules   Module[]
  assessments Assessment[]
  participants PlanParticipant[]
  reviewSteps ReviewStep[]
}

// ------------------------------------------------------------
// REVIEW STEPS — "Study and Review" between a 4-module block and
// its assessment. Opens automatically when module 4 (or 8) completes;
// must be marked complete before the assessment becomes gradeable.
// ------------------------------------------------------------
enum ReviewStepStatus {
  NOT_STARTED
  OPEN
  COMPLETED
}

model ReviewStep {
  id           String           @id @default(uuid())
  planId       String
  plan         DevelopmentPlan  @relation(fields: [planId], references: [id], onDelete: Cascade)
  gatePosition GatePosition     // reusing AFTER_MODULE_4 / AFTER_MODULE_8
  status       ReviewStepStatus @default(NOT_STARTED)
  openedAt     DateTime?
  completedAt  DateTime?

  tasks ReviewStepTask[]

  @@unique([planId, gatePosition])
}

// ------------------------------------------------------------
// REVIEW STEP CONTENT - authored per path + gate (midterm review
// vs final review), copied into real tasks the moment the review
// step itself opens. Only two of the regular task types make sense
// here: FLASHCARD (memorization, pure client-side flip, never
// blocks anything) and ACTION_ITEM (a self-check item with its own
// checkbox - all of them need to be checked before the review step
// can be marked complete, same rule sections already use).
// ------------------------------------------------------------
model ReviewStepTaskTemplate {
  id           String          @id @default(uuid())
  pathId       String
  path         DevelopmentPath @relation(fields: [pathId], references: [id], onDelete: Cascade)
  gatePosition GatePosition
  order        Int
  text         String
  content      String          @default("")
  taskType     String          @default("ACTION_ITEM") // "ACTION_ITEM" or "FLASHCARD"
  link         String?         // ACTION_ITEM only - optional external link

  checklistItemTemplates ReviewStepChecklistItemTemplate[]
}

model ReviewStepChecklistItemTemplate {
  id             String                 @id @default(uuid())
  taskTemplateId String
  taskTemplate   ReviewStepTaskTemplate @relation(fields: [taskTemplateId], references: [id], onDelete: Cascade)
  order          Int
  text           String   // FLASHCARD: front. Unused for ACTION_ITEM.
  description    String?  // FLASHCARD: back.
}

model ReviewStepTask {
  id          String     @id @default(uuid())
  reviewStepId String
  reviewStep  ReviewStep @relation(fields: [reviewStepId], references: [id], onDelete: Cascade)
  order       Int
  text        String
  content     String     @default("")
  taskType    String     @default("ACTION_ITEM")
  link        String?
  completed   Boolean    @default(false) // ACTION_ITEM only
  completedAt DateTime?

  checklistItems ReviewStepChecklistItem[]
}

model ReviewStepChecklistItem {
  id           String         @id @default(uuid())
  reviewStepTaskId String
  reviewStepTask ReviewStepTask @relation(fields: [reviewStepTaskId], references: [id], onDelete: Cascade)
  order        Int
  text         String
  description  String?
}

// ------------------------------------------------------------
// PLAN PARTICIPANTS — the explicit access list for each plan.
// This is the whole access-control model: if you're not listed
// here (and you're not an admin), you can't see or act on this plan.
// ------------------------------------------------------------
enum ParticipantRole {
  DEVELOPER
  DEVELOPEE
  ESCALATION_APPROVER
}

model PlanParticipant {
  id              String          @id @default(uuid())
  planId          String
  plan            DevelopmentPlan @relation(fields: [planId], references: [id], onDelete: Cascade)
  userId          String
  participantRole ParticipantRole

  @@unique([planId, userId]) // one role per person per plan
}

// ------------------------------------------------------------
// MODULES — 8 sequential modules, 5-day auto-lock window
// ------------------------------------------------------------
enum ModuleStatus {
  NOT_STARTED
  OPEN
  COMPLETED
  LOCKED
}

model Module {
  id            String       @id @default(uuid())
  planId        String
  plan          DevelopmentPlan @relation(fields: [planId], references: [id], onDelete: Cascade)
  sequenceOrder Int          // 1 through 8
  status        ModuleStatus @default(NOT_STARTED)
  openedAt      DateTime?
  dueAt         DateTime?    // set to openedAt + 5 days when opened
  completedAt   DateTime?
  lockedAt      DateTime?
  title         String?      // copied from the template when the plan was created
  description   String?      // copied from the template when the plan was created

  @@unique([planId, sequenceOrder]) // no duplicate module numbers within a plan

  events        ModuleEvent[]
  sections      ModuleSection[]
}

// ------------------------------------------------------------
// MODULE SECTIONS — each one is its own page, holding a group of
// tasks. Completed with ONE action at the end of the page, not
// per-task - readings just display, questions/checklists/multiple-
// choice still capture their own data but don't need a separate
// "mark complete" click on top of submitting/answering.
// ------------------------------------------------------------
enum AssignedRole {
  DEVELOPER
  DEVELOPEE
}

model ModuleSection {
  id          String    @id @default(uuid())
  moduleId    String
  module      Module    @relation(fields: [moduleId], references: [id], onDelete: Cascade)
  order       Int
  title       String
  completed   Boolean   @default(false)
  completedAt DateTime?

  tasks ModuleTask[]
}

// ------------------------------------------------------------
// TASKS within a section. Four types: READING (just content, no
// individual completion), QUESTION (locks on submit, reveals
// reference answer), CHECKLIST (sub-items to check off),
// MULTIPLE_CHOICE (auto-graded on submit).
// assignedTo lives HERE, per task - a section can mix tasks for
// both the developer and developee. Advancing past the section
// only requires everything to actually be done, not any one
// person's permission - each task's own action already enforces
// who's allowed to do that specific piece.
// ------------------------------------------------------------
enum TaskType {
  READING
  NOTICE
  WARNING
  QUESTION
  CHECKLIST
  MULTIPLE_CHOICE
  ACTION_ITEM
  VIDEO
  FLASHCARD
  SECTION_QUIZ
}

model ModuleTask {
  id              String    @id @default(uuid())
  sectionId       String
  section         ModuleSection @relation(fields: [sectionId], references: [id], onDelete: Cascade)
  order           Int
  text            String    // short title
  content         String    @default("") // reading material / the question itself
  taskType        TaskType  @default(READING)
  assignedTo      AssignedRole @default(DEVELOPEE)
  correctAnswer   String?   // QUESTION only - NEVER sent to the browser until submitted
  pageReference   String?   // QUESTION only - e.g. "p. 12" or "pages 5-8", shown alongside the question
  submittedAnswer String?   // QUESTION - the developee's locked-in answer
  submittedAt     DateTime? // QUESTION - once set, can never be changed again
  selectedOptionId String?  // MULTIPLE_CHOICE - which option they picked, locked in
  isCorrect        Boolean? // MULTIPLE_CHOICE - computed and stored at submission time
  link             String?  // ACTION_ITEM only - optional external link ("Open link")
  completed        Boolean   @default(false) // ACTION_ITEM only - checked off independently
  completedAt      DateTime?
  quizStatus       String    @default("PENDING") // SECTION_QUIZ only - PENDING/IN_PROGRESS/LOCKED_NEEDS_MEETING/LOCKED_FINAL/PASSED
  quizAttemptCount Int       @default(0)         // SECTION_QUIZ only

  checklistItems TaskChecklistItem[]
  choiceOptions  TaskChoiceOption[]
  quizQuestions  SectionQuizQuestion[]
}

// CHECKLIST sub-items - the actual checkboxes inside a checklist task.
model TaskChecklistItem {
  id          String    @id @default(uuid())
  moduleTaskId String
  moduleTask  ModuleTask @relation(fields: [moduleTaskId], references: [id], onDelete: Cascade)
  order       Int
  text        String    // the item's title
  description String?   // optional short description shown under the title
  link        String?   // optional external link ("Open link")
  completed   Boolean   @default(false)
  completedAt DateTime?
}

// MULTIPLE_CHOICE options - isCorrect must NEVER be sent to the
// browser until the task has actually been answered.
model TaskChoiceOption {
  id           String     @id @default(uuid())
  moduleTaskId String
  moduleTask   ModuleTask @relation(fields: [moduleTaskId], references: [id], onDelete: Cascade)
  order        Int
  text         String
  isCorrect    Boolean
}

// ------------------------------------------------------------
// MODULE TEMPLATES — the reusable curriculum content for each of
// the 8 module "slots." Admin edits these once; every new plan
// copies this content into its own Module records at creation time.
// Editing a template later does NOT change plans already in progress -
// same principle as pairing history: don't silently rewrite the past.
// ------------------------------------------------------------
// ------------------------------------------------------------
// DEVELOPMENT PATHS — distinct named curricula (e.g. "Front of
// House Senior Team Member" vs a different role). Each path has
// its own separate set of 8 modules. pathId stays optional so
// content built before paths existed keeps working without a
// forced migration - it just belongs to whichever path it's
// assigned to (or none, until assigned).
// ------------------------------------------------------------
model DevelopmentPath {
  id          String   @id @default(uuid())
  name        String   @unique
  description String   @default("")
  moduleCount Int      @default(8) // how many modules this path has - the assessment/review gates always land at the halfway point and at the end, whatever that count is
  goalDays    Int      @default(30) // how many days plans on this path get before showing a "due soon" reminder
  maxDays     Int      @default(40) // how many days before a plan on this path shows as overdue
  createdAt   DateTime @default(now())

  moduleTemplates ModuleTemplate[]
  assessmentQuestionTemplates AssessmentQuestionTemplate[]
  reviewStepTaskTemplates ReviewStepTaskTemplate[]
}

model ModuleTemplate {
  id            String   @id @default(uuid())
  pathId        String?
  path          DevelopmentPath? @relation(fields: [pathId], references: [id], onDelete: Cascade)
  sequenceOrder Int      // 1 through 8, unique WITHIN a path
  title         String
  description   String

  sectionTemplates ModuleSectionTemplate[]

  @@unique([pathId, sequenceOrder])
}

model ModuleSectionTemplate {
  id               String         @id @default(uuid())
  moduleTemplateId String
  moduleTemplate   ModuleTemplate @relation(fields: [moduleTemplateId], references: [id], onDelete: Cascade)
  order            Int
  title            String

  taskTemplates ModuleTaskTemplate[]
}

model ModuleTaskTemplate {
  id               String         @id @default(uuid())
  sectionTemplateId String
  sectionTemplate  ModuleSectionTemplate @relation(fields: [sectionTemplateId], references: [id], onDelete: Cascade)
  order            Int
  text             String
  content          String   @default("")
  taskType         TaskType @default(READING)
  assignedTo       AssignedRole @default(DEVELOPEE)
  correctAnswer    String?
  link             String?
  pageReference    String?

  checklistItemTemplates ChecklistItemTemplate[]
  choiceOptionTemplates  ChoiceOptionTemplate[]
  quizQuestionTemplates  SectionQuizQuestionTemplate[]
}

// ------------------------------------------------------------
// SECTION QUIZ - a graded set of multiple-choice questions at the
// end of a section. Needs 90% correct to pass. Auto-graded (no
// developer review needed, unlike assessment short-answer
// questions) - the moment the whole quiz is submitted, the score
// and pass/fail are both known immediately.
//
// Same 3-strike escalation as the midterm/final assessments:
// attempt 1 fails -> retry allowed. attempt 2 fails -> locked,
// needs a developer/developee meeting. attempt 3 fails -> locked,
// needs admin. Scoped to a single task, not a whole plan - most
// sections can have their own quiz.
// ------------------------------------------------------------
model SectionQuizQuestionTemplate {
  id             String             @id @default(uuid())
  taskTemplateId String
  taskTemplate   ModuleTaskTemplate @relation(fields: [taskTemplateId], references: [id], onDelete: Cascade)
  order          Int
  text           String
  content        String             @default("")

  choiceOptionTemplates SectionQuizChoiceOptionTemplate[]
}

model SectionQuizChoiceOptionTemplate {
  id                 String                      @id @default(uuid())
  questionTemplateId String
  questionTemplate   SectionQuizQuestionTemplate @relation(fields: [questionTemplateId], references: [id], onDelete: Cascade)
  order              Int
  text               String
  isCorrect          Boolean
}

model SectionQuizQuestion {
  id          String     @id @default(uuid())
  moduleTaskId String
  moduleTask  ModuleTask @relation(fields: [moduleTaskId], references: [id], onDelete: Cascade)
  order       Int
  text        String
  content     String     @default("")

  choiceOptions SectionQuizChoiceOption[]
  responses     SectionQuizResponse[]
}

model SectionQuizChoiceOption {
  id         String              @id @default(uuid())
  questionId String
  question   SectionQuizQuestion @relation(fields: [questionId], references: [id], onDelete: Cascade)
  order      Int
  text       String
  isCorrect  Boolean
}

model SectionQuizResponse {
  id               String              @id @default(uuid())
  questionId       String
  question         SectionQuizQuestion @relation(fields: [questionId], references: [id], onDelete: Cascade)
  attemptNumber    Int
  selectedOptionId String
  isCorrect        Boolean
  submittedAt      DateTime            @default(now())

  @@unique([questionId, attemptNumber])
}

model ChecklistItemTemplate {
  id               String             @id @default(uuid())
  taskTemplateId   String
  taskTemplate     ModuleTaskTemplate @relation(fields: [taskTemplateId], references: [id], onDelete: Cascade)
  order            Int
  text             String
  description      String?
  link             String?
}

model ChoiceOptionTemplate {
  id               String             @id @default(uuid())
  taskTemplateId   String
  taskTemplate     ModuleTaskTemplate @relation(fields: [taskTemplateId], references: [id], onDelete: Cascade)
  order            Int
  text             String
  isCorrect        Boolean
}

// ------------------------------------------------------------
// MODULE EVENTS — permanent audit trail of every open/complete/lock
// This is what makes the system's history reviewable later:
// "what happened to this module, when, and was it a person or the system?"
// ------------------------------------------------------------
enum ModuleEventType {
  OPENED
  COMPLETED
  LOCKED
  REOPENED
}

model ModuleEvent {
  id        String          @id @default(uuid())
  moduleId  String
  module    Module          @relation(fields: [moduleId], references: [id], onDelete: Cascade)
  eventType ModuleEventType
  actorId   String?         // the user who did this; null means "the system did it automatically"
  timestamp DateTime        @default(now())
}

// ------------------------------------------------------------
// ASSESSMENTS — the midterm (after module 4) and final (after module 8) gates.
// Each allows up to 3 attempts before requiring escalation.
// ------------------------------------------------------------
enum GatePosition {
  AFTER_MODULE_4
  AFTER_MODULE_8
}

enum AssessmentStatus {
  PENDING              // not started yet - module 4 (or 8) isn't complete yet
  IN_PROGRESS          // at least one attempt made, more attempts still available
  LOCKED_NEEDS_MEETING // failed twice - developer must hold a meeting, then reopen
  LOCKED_FINAL         // failed the 3rd and final attempt - needs admin
  PASSED
}

model Assessment {
  id           String           @id @default(uuid())
  planId       String
  plan         DevelopmentPlan  @relation(fields: [planId], references: [id], onDelete: Cascade)
  gatePosition GatePosition
  status       AssessmentStatus @default(PENDING)
  attemptCount Int              @default(0)
  createdAt    DateTime         @default(now())
  openedAt     DateTime?        // set the moment the developee starts THIS attempt - all modules lock while this is set, to prevent looking up answers. Cleared the instant they submit the whole test (not when grading finishes) - a new attempt (after a retry) sets it again fresh.

  attempts     AssessmentAttempt[]
  questions    AssessmentQuestion[]

  @@unique([planId, gatePosition]) // only one midterm and one final per plan
}

// ------------------------------------------------------------
// ASSESSMENT QUESTIONS - authored per path + gate (so each path's
// midterm and final can have their own content), then copied into
// real questions the moment the review step completes and the
// actual Assessment gets created for a plan.
//
// Answering works like Study Questions: open-ended, locks
// permanently once submitted, reveals the model answer right then.
// Responses are tied to a specific ATTEMPT NUMBER (not just the
// question), so failing an attempt and retrying gives fresh,
// separate answers - the old attempt's answers stay exactly as
// they were, never overwritten.
// ------------------------------------------------------------
// questionType: 'SHORT_ANSWER' (developer grades it manually, model
// answer never shown to the developee) or 'MULTIPLE_CHOICE' (auto-
// graded immediately, since it's objectively checkable).
model AssessmentQuestionTemplate {
  id            String          @id @default(uuid())
  pathId        String
  path          DevelopmentPath @relation(fields: [pathId], references: [id], onDelete: Cascade)
  gatePosition  GatePosition
  order         Int
  text          String
  content       String          @default("")
  questionType  String          @default("SHORT_ANSWER")
  correctAnswer String?         // SHORT_ANSWER only - the model answer the developer compares against
  pageReference String?

  choiceOptionTemplates AssessmentChoiceOptionTemplate[]
}

model AssessmentChoiceOptionTemplate {
  id                String                     @id @default(uuid())
  questionTemplateId String
  questionTemplate  AssessmentQuestionTemplate @relation(fields: [questionTemplateId], references: [id], onDelete: Cascade)
  order             Int
  text              String
  isCorrect         Boolean
}

model AssessmentQuestion {
  id            String     @id @default(uuid())
  assessmentId  String
  assessment    Assessment @relation(fields: [assessmentId], references: [id], onDelete: Cascade)
  order         Int
  text          String
  content       String     @default("")
  questionType  String     @default("SHORT_ANSWER")
  correctAnswer String?
  pageReference String?

  choiceOptions AssessmentChoiceOption[]
  responses     AssessmentQuestionResponse[]
}

model AssessmentChoiceOption {
  id         String             @id @default(uuid())
  questionId String
  question   AssessmentQuestion @relation(fields: [questionId], references: [id], onDelete: Cascade)
  order      Int
  text       String
  isCorrect  Boolean
}

model AssessmentQuestionResponse {
  id               String             @id @default(uuid())
  questionId       String
  question         AssessmentQuestion @relation(fields: [questionId], references: [id], onDelete: Cascade)
  attemptNumber    Int                // which attempt this answer belongs to - a retry gets fresh answers, not overwritten history
  submittedAnswer  String?            // SHORT_ANSWER - never shown back to the developee as "correct/incorrect", only to the developer while grading
  selectedOptionId String?            // MULTIPLE_CHOICE - which option they picked, locked in
  isCorrect        Boolean?           // MULTIPLE_CHOICE - computed and stored at submission time, auto-graded
  submittedAt      DateTime           @default(now())

  @@unique([questionId, attemptNumber]) // one locked-in answer per question per attempt
}

model AssessmentAttempt {
  id            String     @id @default(uuid())
  assessmentId  String
  assessment    Assessment @relation(fields: [assessmentId], references: [id], onDelete: Cascade)
  attemptNumber Int        // 1, 2, or 3
  overallResult String     // "PASS" or "FAIL"
  gradedBy      String     // the developer's user id who graded it
  gradedAt      DateTime   @default(now())

  itemScores    AssessmentItemScore[]
}

model AssessmentItemScore {
  id        String            @id @default(uuid())
  attemptId String
  attempt   AssessmentAttempt @relation(fields: [attemptId], references: [id], onDelete: Cascade)
  moduleId  String            // which of the 4 modules in this block this score is for
  score     Int
  comments  String?
}
