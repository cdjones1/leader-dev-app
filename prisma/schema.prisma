// ============================================================
// This file describes every table in the database.
// Run `npx prisma migrate dev` to turn this into a real database.
// ============================================================

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ------------------------------------------------------------
// ROLES — the 5-tier hierarchy plus an admin flag
// ------------------------------------------------------------
enum Role {
  OPERATIONS_SPECIALIST
  TEAM_LEADER
  MANAGER
  ASSISTANT_DIRECTOR
  DIRECTOR
}

// ------------------------------------------------------------
// USERS
// ------------------------------------------------------------
model User {
  id           String   @id @default(uuid())
  name         String
  email        String   @unique
  passwordHash String   // never store plain passwords — this is the encrypted version
  role         Role
  isAdmin      Boolean  @default(false)
  createdAt    DateTime @default(now())

  // A user can be a manager to other users (self-referencing relationship)
  managerId    String?
  manager      User?    @relation("ManagerToReports", fields: [managerId], references: [id])
  reports      User[]   @relation("ManagerToReports")

  // Pairings this user is part of (as either developer or developee)
  pairingsAsDeveloper DeveloperPairing[] @relation("DeveloperPairings")
  pairingsAsDevelopee DeveloperPairing[] @relation("DevelopeePairings")
}

// ------------------------------------------------------------
// DEVELOPER PAIRINGS — admin-assigned developer <-> developee link
// ------------------------------------------------------------
enum PairingStatus {
  ACTIVE
  ENDED
}

model DeveloperPairing {
  id          String        @id @default(uuid())
  developerId String
  developer   User          @relation("DeveloperPairings", fields: [developerId], references: [id])
  developeeId String
  developee   User          @relation("DevelopeePairings", fields: [developeeId], references: [id])
  status      PairingStatus @default(ACTIVE)
  assignedBy  String        // the admin's user id who created this pairing
  startDate   DateTime      @default(now())
  endDate     DateTime?

  plans       DevelopmentPlan[]
}

// ------------------------------------------------------------
// DEVELOPMENT PLANS — the 30-day / 8-module process
// ------------------------------------------------------------
enum PlanStatus {
  IN_PROGRESS
  COMPLETE
}

model DevelopmentPlan {
  id        String     @id @default(uuid())
  pairingId String
  pairing   DeveloperPairing @relation(fields: [pairingId], references: [id])
  status    PlanStatus @default(IN_PROGRESS)
  createdAt DateTime   @default(now())
  startedAt DateTime?  // set the moment module 1 is actually opened - this is when the real 40-day clock begins, not when the plan record was created

  modules   Module[]
  assessments Assessment[]
  participants PlanParticipant[]
  reviewSteps ReviewStep[]
}

// ------------------------------------------------------------
// REVIEW STEPS — "Study and Review" between a 4-module block and
// its assessment. Opens automatically when module 4 (or 8) completes;
// must be marked complete before the assessment becomes gradeable.
// ------------------------------------------------------------
enum ReviewStepStatus {
  NOT_STARTED
  OPEN
  COMPLETED
}

model ReviewStep {
  id           String           @id @default(uuid())
  planId       String
  plan         DevelopmentPlan  @relation(fields: [planId], references: [id], onDelete: Cascade)
  gatePosition GatePosition     // reusing AFTER_MODULE_4 / AFTER_MODULE_8
  status       ReviewStepStatus @default(NOT_STARTED)
  openedAt     DateTime?
  completedAt  DateTime?

  @@unique([planId, gatePosition])
}

// ------------------------------------------------------------
// PLAN PARTICIPANTS — the explicit access list for each plan.
// This is the whole access-control model: if you're not listed
// here (and you're not an admin), you can't see or act on this plan.
// ------------------------------------------------------------
enum ParticipantRole {
  DEVELOPER
  DEVELOPEE
  ESCALATION_APPROVER
}

model PlanParticipant {
  id              String          @id @default(uuid())
  planId          String
  plan            DevelopmentPlan @relation(fields: [planId], references: [id], onDelete: Cascade)
  userId          String
  participantRole ParticipantRole

  @@unique([planId, userId]) // one role per person per plan
}

// ------------------------------------------------------------
// MODULES — 8 sequential modules, 5-day auto-lock window
// ------------------------------------------------------------
enum ModuleStatus {
  NOT_STARTED
  OPEN
  COMPLETED
  LOCKED
}

model Module {
  id            String       @id @default(uuid())
  planId        String
  plan          DevelopmentPlan @relation(fields: [planId], references: [id], onDelete: Cascade)
  sequenceOrder Int          // 1 through 8
  status        ModuleStatus @default(NOT_STARTED)
  openedAt      DateTime?
  dueAt         DateTime?    // set to openedAt + 5 days when opened
  completedAt   DateTime?
  lockedAt      DateTime?
  title         String?      // copied from the template when the plan was created
  description   String?      // copied from the template when the plan was created

  @@unique([planId, sequenceOrder]) // no duplicate module numbers within a plan

  events        ModuleEvent[]
  sections      ModuleSection[]
}

// ------------------------------------------------------------
// MODULE SECTIONS — each one is its own page, holding a group of
// tasks. Completed with ONE action at the end of the page, not
// per-task - readings just display, questions/checklists/multiple-
// choice still capture their own data but don't need a separate
// "mark complete" click on top of submitting/answering.
// ------------------------------------------------------------
enum AssignedRole {
  DEVELOPER
  DEVELOPEE
}

model ModuleSection {
  id          String    @id @default(uuid())
  moduleId    String
  module      Module    @relation(fields: [moduleId], references: [id], onDelete: Cascade)
  order       Int
  title       String
  assignedTo  AssignedRole @default(DEVELOPEE) // who completes this whole section
  completed   Boolean   @default(false)
  completedAt DateTime?

  tasks ModuleTask[]
}

// ------------------------------------------------------------
// TASKS within a section. Four types: READING (just content, no
// individual completion), QUESTION (locks on submit, reveals
// reference answer), CHECKLIST (sub-items to check off),
// MULTIPLE_CHOICE (auto-graded on submit).
// ------------------------------------------------------------
enum TaskType {
  READING
  NOTICE
  WARNING
  QUESTION
  CHECKLIST
  MULTIPLE_CHOICE
}

model ModuleTask {
  id              String    @id @default(uuid())
  sectionId       String
  section         ModuleSection @relation(fields: [sectionId], references: [id], onDelete: Cascade)
  order           Int
  text            String    // short title
  content         String    @default("") // reading material / the question itself
  taskType        TaskType  @default(READING)
  correctAnswer   String?   // QUESTION only - NEVER sent to the browser until submitted
  submittedAnswer String?   // QUESTION - the developee's locked-in answer
  submittedAt     DateTime? // QUESTION - once set, can never be changed again
  selectedOptionId String?  // MULTIPLE_CHOICE - which option they picked, locked in
  isCorrect        Boolean? // MULTIPLE_CHOICE - computed and stored at submission time

  checklistItems TaskChecklistItem[]
  choiceOptions  TaskChoiceOption[]
}

// CHECKLIST sub-items - the actual checkboxes inside a checklist task.
model TaskChecklistItem {
  id          String    @id @default(uuid())
  moduleTaskId String
  moduleTask  ModuleTask @relation(fields: [moduleTaskId], references: [id], onDelete: Cascade)
  order       Int
  text        String
  completed   Boolean   @default(false)
  completedAt DateTime?
}

// MULTIPLE_CHOICE options - isCorrect must NEVER be sent to the
// browser until the task has actually been answered.
model TaskChoiceOption {
  id           String     @id @default(uuid())
  moduleTaskId String
  moduleTask   ModuleTask @relation(fields: [moduleTaskId], references: [id], onDelete: Cascade)
  order        Int
  text         String
  isCorrect    Boolean
}

// ------------------------------------------------------------
// MODULE TEMPLATES — the reusable curriculum content for each of
// the 8 module "slots." Admin edits these once; every new plan
// copies this content into its own Module records at creation time.
// Editing a template later does NOT change plans already in progress -
// same principle as pairing history: don't silently rewrite the past.
// ------------------------------------------------------------
model ModuleTemplate {
  id            String   @id @default(uuid())
  sequenceOrder Int      @unique // 1 through 8
  title         String
  description   String

  sectionTemplates ModuleSectionTemplate[]
}

model ModuleSectionTemplate {
  id               String         @id @default(uuid())
  moduleTemplateId String
  moduleTemplate   ModuleTemplate @relation(fields: [moduleTemplateId], references: [id], onDelete: Cascade)
  order            Int
  title            String
  assignedTo       AssignedRole @default(DEVELOPEE)

  taskTemplates ModuleTaskTemplate[]
}

model ModuleTaskTemplate {
  id               String         @id @default(uuid())
  sectionTemplateId String
  sectionTemplate  ModuleSectionTemplate @relation(fields: [sectionTemplateId], references: [id], onDelete: Cascade)
  order            Int
  text             String
  content          String   @default("")
  taskType         TaskType @default(READING)
  correctAnswer    String?

  checklistItemTemplates ChecklistItemTemplate[]
  choiceOptionTemplates  ChoiceOptionTemplate[]
}

model ChecklistItemTemplate {
  id               String             @id @default(uuid())
  taskTemplateId   String
  taskTemplate     ModuleTaskTemplate @relation(fields: [taskTemplateId], references: [id], onDelete: Cascade)
  order            Int
  text             String
}

model ChoiceOptionTemplate {
  id               String             @id @default(uuid())
  taskTemplateId   String
  taskTemplate     ModuleTaskTemplate @relation(fields: [taskTemplateId], references: [id], onDelete: Cascade)
  order            Int
  text             String
  isCorrect        Boolean
}

// ------------------------------------------------------------
// MODULE EVENTS — permanent audit trail of every open/complete/lock
// This is what makes the system's history reviewable later:
// "what happened to this module, when, and was it a person or the system?"
// ------------------------------------------------------------
enum ModuleEventType {
  OPENED
  COMPLETED
  LOCKED
  REOPENED
}

model ModuleEvent {
  id        String          @id @default(uuid())
  moduleId  String
  module    Module          @relation(fields: [moduleId], references: [id], onDelete: Cascade)
  eventType ModuleEventType
  actorId   String?         // the user who did this; null means "the system did it automatically"
  timestamp DateTime        @default(now())
}

// ------------------------------------------------------------
// ASSESSMENTS — the midterm (after module 4) and final (after module 8) gates.
// Each allows up to 3 attempts before requiring escalation.
// ------------------------------------------------------------
enum GatePosition {
  AFTER_MODULE_4
  AFTER_MODULE_8
}

enum AssessmentStatus {
  PENDING              // not started yet - module 4 (or 8) isn't complete yet
  IN_PROGRESS          // at least one attempt made, more attempts still available
  LOCKED_NEEDS_MEETING // failed twice - developer must hold a meeting, then reopen
  LOCKED_FINAL         // failed the 3rd and final attempt - needs admin
  PASSED
}

model Assessment {
  id           String           @id @default(uuid())
  planId       String
  plan         DevelopmentPlan  @relation(fields: [planId], references: [id], onDelete: Cascade)
  gatePosition GatePosition
  status       AssessmentStatus @default(PENDING)
  attemptCount Int              @default(0)
  createdAt    DateTime         @default(now())

  attempts     AssessmentAttempt[]

  @@unique([planId, gatePosition]) // only one midterm and one final per plan
}

model AssessmentAttempt {
  id            String     @id @default(uuid())
  assessmentId  String
  assessment    Assessment @relation(fields: [assessmentId], references: [id], onDelete: Cascade)
  attemptNumber Int        // 1, 2, or 3
  overallResult String     // "PASS" or "FAIL"
  gradedBy      String     // the developer's user id who graded it
  gradedAt      DateTime   @default(now())

  itemScores    AssessmentItemScore[]
}

model AssessmentItemScore {
  id        String            @id @default(uuid())
  attemptId String
  attempt   AssessmentAttempt @relation(fields: [attemptId], references: [id], onDelete: Cascade)
  moduleId  String            // which of the 4 modules in this block this score is for
  score     Int
  comments  String?
}
